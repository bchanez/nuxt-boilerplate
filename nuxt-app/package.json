{
  "name": "nuxt-app",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "node .output/server/index.mjs",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prepare": "husky",
    "typecheck": "nuxt prepare && vue-tsc -b --noEmit",
    "test:visual": "playwright test --project=visual",
    "test:visualupdate": "playwright test --project=visual --update-snapshots",
    "test:e2e": "playwright test --project=e2e"
  },
  "dependencies": {
    "@nuxt/eslint": "1.5.2",
    "@nuxt/image": "2.1.0",
    "@nuxtjs/robots": "6.2.0",
    "@nuxtjs/sitemap": "8.5.0",
    "@tailwindcss/vite": "4.1.3",
    "@vercel/analytics": "2.0.1",
    "@vercel/speed-insights": "2.0.0",
    "@vueuse/core": "14.4.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-vue-next": "1.0.0",
    "motion-v": "2.4.0",
    "nuxt": "4.0.0",
    "reka-ui": "2.2.0",
    "shadcn-nuxt": "2.2.0",
    "tailwind-merge": "3.1.0",
    "tailwindcss": "4.1.3",
    "tw-animate-css": "1.2.5",
    "vue": "3.5.13",
    "vue-router": "5.3.0"
  },
  "devDependencies": {
    "@nuxt/test-utils": "4.2.0",
    "@playwright/test": "1.54.1",
    "@types/node": "22.14.0",
    "@vue/test-utils": "2.4.6",
    "eslint": "10.9.1",
    "happy-dom": "20.11.12",
    "playwright-core": "1.54.1",
    "typescript": "7.0.2",
    "vitest": "4.1.11",
    "vue-tsc": "3.0.2"
  }
}