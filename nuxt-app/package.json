{
  "name": "nuxt-app",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "node .output/server/index.mjs",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prepare": "husky",
    "typecheck": "nuxt prepare && vue-tsc -b --noEmit",
    "test:visual": "playwright test --project=visual",
    "test:visualupdate": "playwright test --project=visual --update-snapshots",
    "test:e2e": "playwright test --project=e2e"
  },
  "dependencies": {
    "@nuxt/eslint": "1.17.0",
    "@nuxt/image": "2.1.0",
    "@nuxtjs/robots": "7.0.2",
    "@nuxtjs/sitemap": "9.1.0",
    "@tailwindcss/vite": "4.3.3",
    "@vercel/analytics": "2.0.1",
    "@vercel/speed-insights": "2.0.0",
    "@vueuse/core": "15.0.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-vue-next": "1.0.0",
    "motion-v": "2.8.0",
    "nuxt": "4.6.1",
    "reka-ui": "2.11.0",
    "shadcn-nuxt": "2.8.2",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "vue": "3.5.44",
    "vue-router": "5.4.0"
  },
  "devDependencies": {
    "@nuxt/test-utils": "4.3.4",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "@vue/test-utils": "2.5.1",
    "eslint": "10.13.0",
    "happy-dom": "21.0.3",
    "playwright-core": "1.64.1",
    "typescript": "7.0.2",
    "vitest": "5.0.5",
    "vue-tsc": "3.3.13"
  }
}
